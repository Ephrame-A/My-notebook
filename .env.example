

# Local mode is the default and keeps the existing Chroma/PyTorch stack.
RAG_MODE=local

# Hosted mode (Render + Supabase): set RAG_MODE=hosted, run sql/supabase.sql,
# and provide the Postgres transaction-pooler URI and a stable random secret.
# SUPABASE_DB_URL=postgresql://postgres.PROJECT:password@HOST:6543/postgres
# FLASK_SECRET_KEY=replace-with-a-long-random-secret
# GEMINI_API_KEY=optional-server-key-for-direct-API-clients

# Optional overrides (defaults shown)
CHUNK_SIZE=500
CHUNK_OVERLAP=80
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
MAX_HOSTED_CHUNKS_PER_FILE=80
MAX_HOSTED_SOURCES=5
HYBRID_ALPHA=0.5
TOP_K=5
GEMINI_MODEL_NAME=gemini-2.5-flash
CHROMA_DB_PATH=./chroma_db
UPLOAD_FOLDER=./uploads
PORT=5000
FLASK_DEBUG=false
